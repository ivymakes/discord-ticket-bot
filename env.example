# Copy this file to ".env" and fill in your own values.
# Never share your .env file or your bot token with anyone.
#
# Everything else (support roles, ticket category, transcript channel)
# is set in config.js instead, since those aren't secrets.

# Your bot's token, from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Your bot's Application ID, from the "General Information" tab of the same page
CLIENT_ID=

# The ID of the Discord server you're running this in (right-click the server icon -> Copy Server ID)
# You need Developer Mode on: User Settings -> Advanced -> Developer Mode
GUILD_ID=
